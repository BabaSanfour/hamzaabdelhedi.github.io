{
  "name": "hamza-abdelhedi-website",
  "private": true,
  "description": "Personal website of Hamza Abdelhedi - PhD student in Biomedical Engineering focused on Neuro-AI. Built with Jekyll and Bookshop, based on CloudCannon's Vonge template.",
  "scripts": {
    "bookshop": "bookshop-browser",
    "jekyll:install": "BUNDLE_GEMFILE=site/Gemfile bundle install",
    "bookshop-dev": "bookshop-browser -p 6086 -b ./component-library",
    "bookshop-hosted": "bookshop-browser -b ./component-library -o site/js/bookshop-hosted.js",
    "bookshop-live": "bookshop-live -b ./component-library -o site/_cloudcannon/bookshop-live.js",
    "jekyll": "BUNDLE_GEMFILE=site/Gemfile bundle exec jekyll serve --source site --port 6060 --trace --unpublished",
    "start": "run-p bookshop jekyll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BabaSanfour/hamzaabdelhedi.github.io.git"
  },
  "author": "Hamza Abdelhedi <hamza.abdelhedi@umontreal.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BabaSanfour/hamzaabdelhedi.github.io/issues"
  },
  "homepage": "https://hamzaabdelhedi.com",
  "devDependencies": {
    "@bookshop/jekyll-engine": "^3.17.1",
    "@bookshop/live": "3.9.0",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@bookshop/browser": "^3.10.1",
    "@bookshop/generate": "^2.4.2"
  }
}